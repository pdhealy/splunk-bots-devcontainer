#!/usr/bin/env sh
set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
cd "$root"

for command in docker devcontainer; do
    command -v "$command" >/dev/null 2>&1 || {
        printf '%s\n' "Missing required command: $command" >&2
        exit 127
    }
done

docker info >/dev/null 2>&1 || {
    printf '%s\n' "A reachable Docker daemon is required to run the launch matrix." >&2
    exit 1
}

artifacts_dir=$(mktemp -d "${TMPDIR:-/tmp}/bots-launch-matrix.XXXXXX")
active_project=
active_service=

cleanup() {
    status=$?
    trap - EXIT HUP INT TERM

    if [ -n "$active_project" ]; then
        if [ "$status" -ne 0 ]; then
            log_file="$artifacts_dir/${active_service}.log"
            docker compose --project-name "$active_project" logs --no-color >"$log_file" 2>&1 || true
            printf '%s\n' "Captured failure logs in $log_file" >&2
        fi

        docker compose --project-name "$active_project" down --volumes --remove-orphans >/dev/null 2>&1 || true
    fi

    exit "$status"
}

trap cleanup EXIT HUP INT TERM

for service in bots1 bots2 bots3; do
    active_service=$service
    active_project="bots-launch-${service}-$$"
    export COMPOSE_PROJECT_NAME=$active_project

    docker compose up --wait --wait-timeout 1800 "$service"
    docker compose down --volumes --remove-orphans

    BOTS_SERVICE=$service devcontainer up --workspace-folder "$root"
    docker compose up --wait --wait-timeout 1800 "$service"
    docker compose down --volumes --remove-orphans

    active_project=
    active_service=
done

rmdir "$artifacts_dir"
